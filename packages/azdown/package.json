{
  "name": "azdown",
  "displayName": "azdown",
  "publisher": "leozamarron",
  "description": "Renders Markdown in VS Code exactly like Azure DevOps Wiki does — syntax and styling.",
  "version": "0.0.1",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0",
    "node": ">=24"
  },
  "categories": [
    "Programming Languages",
    "Visualization",
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./media/azdown.css"
    ],
    "markdown.previewScripts": [
      "./dist/preview.js"
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "azdown",
          "title": "Azure DevOps Wiki",
          "icon": "media/wiki.svg"
        }
      ]
    },
    "views": {
      "azdown": [
        {
          "id": "azdown.pages",
          "name": "Pages"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "azdown.pages",
        "contents": "No Azure DevOps wiki found in this workspace.\n\nazdown looks for a folder containing a .order file. You can also pick one yourself.\n\n[Choose wiki folder](command:azdown.chooseWikiRoot)"
      }
    ],
    "commands": [
      {
        "command": "azdown.chooseWikiRoot",
        "title": "Choose Wiki Folder",
        "category": "azdown",
        "icon": "$(folder-opened)"
      },
      {
        "command": "azdown.refresh",
        "title": "Refresh Wiki Tree",
        "category": "azdown",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "azdown.chooseWikiRoot",
          "when": "view == azdown.pages",
          "group": "navigation@1"
        },
        {
          "command": "azdown.refresh",
          "when": "view == azdown.pages",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "azdown",
      "properties": {
        "azdown.wikiRoot": {
          "type": "string",
          "default": "",
          "markdownDescription": "Folder to treat as the Azure DevOps wiki root. Absolute, or relative to the first workspace folder. Leave empty to autodetect by looking for the shallowest folder containing a `.order` file."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit && tsc --noEmit -p tsconfig.preview.json",
    "lint": "eslint src",
    "test": "vscode-test",
    "package:vsix": "npm run package && npx --yes @vscode/vsce package --no-dependencies",
    "publish:marketplace": "npm run package && npx --yes @vscode/vsce publish --no-dependencies"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "1.75.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "dependencies": {
    "markdown-it-azdown": "*",
    "mermaid": "^11.17.2"
  },
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/leozamarron/azdown.git",
    "directory": "packages/azdown"
  },
  "bugs": {
    "url": "https://github.com/leozamarron/azdown/issues"
  },
  "homepage": "https://github.com/leozamarron/azdown#readme",
  "keywords": [
    "azure devops",
    "azure devops wiki",
    "wiki",
    "markdown",
    "markdown preview",
    "mermaid",
    "toc",
    "katex",
    "ado"
  ],
  "galleryBanner": {
    "color": "#0078D4",
    "theme": "dark"
  }
}
