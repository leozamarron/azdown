// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
//
// The release-check launch builds both packages from the repository root.
// Watch tasks run inside packages/azdown.
{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build:extension",
			"type": "shell",
			"command": "npm run compile",
			"options": { "cwd": "${workspaceFolder}" },
			"problemMatcher": "$tsc",
			"group": "build"
		},
		{
			"label": "watch",
			"dependsOn": [
				"npm: watch:tsc",
				"npm: watch:esbuild"
			],
			"presentation": {
				"reveal": "never"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"type": "npm",
			"script": "watch:esbuild",
			"path": "packages/azdown/",
			"group": "build",
			"problemMatcher": "$esbuild-watch",
			"isBackground": true,
			"label": "npm: watch:esbuild",
			"presentation": {
				"group": "watch",
				"reveal": "never"
			}
		},
		{
			"type": "npm",
			"script": "watch:tsc",
			"path": "packages/azdown/",
			"group": "build",
			"problemMatcher": "$tsc-watch",
			"isBackground": true,
			"label": "npm: watch:tsc",
			"presentation": {
				"group": "watch",
				"reveal": "never"
			}
		},
		{
			"type": "npm",
			"script": "watch-tests",
			"path": "packages/azdown/",
			"label": "npm: watch-tests",
			"problemMatcher": "$tsc-watch",
			"isBackground": true,
			"presentation": {
				"reveal": "never",
				"group": "watchers"
			},
			"group": "build"
		},
		{
			"label": "tasks: watch-tests",
			"dependsOn": [
				"watch",
				"npm: watch-tests"
			],
			"problemMatcher": []
		}
	]
}
